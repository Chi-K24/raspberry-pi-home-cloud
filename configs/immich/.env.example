# Never commit the real .env file.

UPLOAD_LOCATION=/srv/immich-library/immich-managed
DB_DATA_LOCATION=/srv/immich-data/postgres
IMMICH_THUMBS_LOCATION=/srv/immich-data/thumbs
IMMICH_EXTERNAL_LIBRARY=/srv/immich-library/import-staging

TZ=Region/City
IMMICH_VERSION=v3

# Generate a unique high-entropy password for the real deployment.
DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_SECRET
